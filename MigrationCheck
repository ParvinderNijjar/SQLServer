### 5.2 Database files (sizes, paths, growth)

```sql
SELECT
    DB_NAME(mf.database_id)               AS database_name,
    mf.file_id,
    mf.type_desc,
    mf.name                               AS logical_name,
    mf.physical_name,
    mf.state_desc,
    mf.size * 8.0 / 1024                  AS size_mb,
    CASE WHEN mf.max_size = -1 THEN -1
         WHEN mf.max_size = 268435456 THEN -1  -- log "unlimited"
         ELSE mf.max_size * 8.0 / 1024 END AS max_size_mb,
    CASE WHEN mf.is_percent_growth = 1 THEN CAST(mf.growth AS VARCHAR(10)) + '%'
         ELSE CAST(mf.growth * 8 / 1024 AS VARCHAR(10)) + ' MB' END AS growth,
    mf.is_read_only
FROM sys.master_files mf
ORDER BY DB_NAME(mf.database_id), mf.type_desc, mf.file_id;
```

### 5.3 Filegroups per database

```sql
DECLARE @sql NVARCHAR(MAX) = N'';
SELECT @sql = @sql + N'
USE ' + QUOTENAME(name) + N';
SELECT DB_NAME() AS database_name, fg.name AS filegroup_name, fg.type_desc,
       fg.is_default, fg.is_read_only
FROM sys.filegroups fg;'
FROM sys.databases WHERE state_desc = 'ONLINE' AND database_id > 4;
EXEC sp_executesql @sql;
```

### 5.4 Compatibility levels (called out separately for clarity)

```sql
SELECT name, compatibility_level
FROM sys.databases
ORDER BY name;
```

### 5.5 Last successful DBCC CHECKDB (critical pre-migration check)

```sql
SET NOCOUNT ON;
DECLARE @results TABLE (
    database_name SYSNAME,
    last_known_good_checkdb VARCHAR(50)
);
DECLARE @DBInfo TABLE (
    ParentObject NVARCHAR(255), [Object] NVARCHAR(255),
    Field NVARCHAR(255), [Value] NVARCHAR(MAX)
);
DECLARE @dbname SYSNAME, @sql NVARCHAR(MAX);

DECLARE c CURSOR LOCAL FAST_FORWARD FOR
    SELECT name FROM sys.databases
    WHERE state_desc = 'ONLINE' AND database_id <> 2;  -- skip tempdb
OPEN c;
FETCH NEXT FROM c INTO @dbname;
WHILE @@FETCH_STATUS = 0
BEGIN
    DELETE @DBInfo;
    SET @sql = N'USE ' + QUOTENAME(@dbname) + N'; DBCC DBINFO WITH TABLERESULTS;';
    BEGIN TRY
        INSERT @DBInfo EXEC sp_executesql @sql;
        INSERT @results
        SELECT @dbname, [Value]
        FROM @DBInfo
        WHERE Field = 'dbi_dbccLastKnownGood';
    END TRY
    BEGIN CATCH
        INSERT @results VALUES (@dbname, 'ERROR: ' + ERROR_MESSAGE());
    END CATCH
    FETCH NEXT FROM c INTO @dbname;
END
CLOSE c; DEALLOCATE c;
SELECT * FROM @results ORDER BY last_known_good_checkdb;
```

If any database shows `1900-01-01` it has never had a successful CHECKDB. **Run CHECKDB before migrating.** If it fails on the source, fix corruption before going anywhere.

