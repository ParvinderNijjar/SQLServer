## 7. PRE-MIGRATION: SQL Server Agent

### 7.1 Jobs, steps, schedules, owners

```sql
USE msdb;

-- Jobs
SELECT
    j.job_id, j.name, j.enabled,
    SUSER_SNAME(j.owner_sid) AS owner,
    c.name AS category, j.description,
    j.date_created, j.date_modified,
    j.notify_level_eventlog, j.notify_level_email, j.notify_level_netsend, j.notify_level_page,
    op.name AS notify_email_operator
FROM dbo.sysjobs j
LEFT JOIN dbo.syscategories c ON j.category_id = c.category_id
LEFT JOIN dbo.sysoperators op ON j.notify_email_operator_id = op.id
ORDER BY j.name;

-- Job steps
SELECT
    j.name AS job_name,
    s.step_id, s.step_name, s.subsystem, s.database_name, s.last_run_outcome,
    s.command, s.on_success_action, s.on_fail_action, s.retry_attempts, s.retry_interval,
    p.name AS proxy_name
FROM dbo.sysjobs j
JOIN dbo.sysjobsteps s ON j.job_id = s.job_id
LEFT JOIN dbo.sysproxies p ON s.proxy_id = p.proxy_id
ORDER BY j.name, s.step_id;

-- Schedules
SELECT
    j.name AS job_name,
    sch.name AS schedule_name, sch.enabled,
    sch.freq_type, sch.freq_interval, sch.freq_subday_type, sch.freq_subday_interval,
    sch.freq_relative_interval, sch.freq_recurrence_factor,
    sch.active_start_date, sch.active_end_date,
    sch.active_start_time, sch.active_end_time
FROM dbo.sysjobs j
JOIN dbo.sysjobschedules js ON j.job_id = js.job_id
JOIN dbo.sysschedules    sch ON js.schedule_id = sch.schedule_id
ORDER BY j.name, sch.name;

-- Operators
SELECT id, name, enabled, email_address, last_email_date
FROM dbo.sysoperators;

-- Alerts
SELECT a.id, a.name, a.enabled, a.message_id, a.severity, a.database_name,
       a.event_description_keyword, a.occurrence_count, a.last_occurrence_date,
       op.name AS notify_operator
FROM dbo.sysalerts a
LEFT JOIN dbo.sysnotifications n ON a.id = n.alert_id
LEFT JOIN dbo.sysoperators op    ON n.operator_id = op.id;

-- Proxies
SELECT p.proxy_id, p.name, c.name AS credential, p.enabled, p.description
FROM dbo.sysproxies p
LEFT JOIN sys.credentials c ON p.credential_id = c.credential_id;
```

